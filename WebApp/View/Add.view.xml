<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="tv.sd.abap.Controller.Add"
 xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core"
>
    <Page title="Manage Orders">
        <content>     
		<f:SimpleForm id="SimpleFormChange354"
			editable="true"
			layout="ResponsiveGridLayout"
			title="Address"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label text="Delivery" />
				<Input id="idDelivery" value="{local>/Delivery/Vbeln}" submit="onSubmit" showValueHelp="true"
                                           valueHelpRequest="onF4Help"/>
				<Button tooltip="Get Most Expensive Product" icon="sap-icon://iphone" press="getMostExpDel"/>
				<Label text="Price" />
				<Input value="{local>/Delivery/Netwr}">
				</Input>
				<Input value="{local>/Delivery/Waerk}">
					<layoutData>
						<l:GridData span="XL1 L2 M2 S4" />
					</layoutData>
				</Input>
				<Label text="Created By/ Refrence Document" />
				<Input value="{local>/Delivery/Ernam}">
					<layoutData>
						<l:GridData span="XL1 L2 M2 S4" />
					</layoutData>
				</Input>
				<Input value="{local>/Delivery/Vgbel}" />
				<Label text="Category" />
				<Select id="Lfart" selectedKey="{local>/Delivery/Lfart}">
					<items>
						<core:Item text="Replenishment Dlv."   key="NL"/>
						<core:Item text="Outbound Delivery"    key="LF"/>
						<core:Item text="Delivery for Subcon." key="LB"/>
					</items>
				</Select>
			</f:content>
		</f:SimpleForm>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button id="idSave"   text="Save"   type="Accept"     icon="sap-icon://save"   press="onSave"   />
                <Button id="idDelete" text="Delete" type="Reject"     icon="sap-icon://cancel" press="onDelete" />
                <Button id="idClear"  text="Clear"  type="Emphasized" icon="sap-icon://cancel" press="onClear"  />
            </Toolbar>
        </footer>
    </Page>
</mvc:View >