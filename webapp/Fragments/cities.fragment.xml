<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
                    <Select items="{/cities}">
                        <items>
                            <core:Item text="{name}">
                            </core:Item>
                        </items>
                    </Select>
                    <ComboBox items="{/cities}">
                        <items>
                            <core:Item text="{name}"
                                       key="{name}"
                            />
                        </items>
                    </ComboBox>
                    <MultiComboBox items="{/cities}">
                        <items>
                            <core:Item text="{name}"
                                       key="{name}"
                            />
                        </items>
                    </MultiComboBox>
</core:FragmentDefinition>