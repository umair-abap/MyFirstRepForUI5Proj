{
    "sap.app":{
        "id":"tv.sd.abap",
        "type":"application",
        "applicationVersion":{
            "version":"1.0.0"
        },
        "ach":"FIN-ACC-APP",
        "title":"{{appTitle}}",
        "i18n":"i18n/i18n.properties",
        "dataSources":{
            "ZTEST_DELIVERY_ODATA_SRV":{
                "uri":"/sap/opu/odata/sap/ZTEST_DELIVERY_ODATA_SRV/",
                "type":"OData",
                "settings":{
                    "odataVersion":"2.0"
                }
            }
        }
    },
    "sap.ui":{
        "deviceTypes":{
            "desktop":true,
            "tablet":true,
            "phone":true
        },
        "supportedThemes":["sap_horizon","sap_fiori_3_light"],
        "technology":"ui5"
    },
    "sap.ui5":{
        "dependencies":{
            "minUI5Version":"1.100.2",
            "libs":{
                "sap.m":{
                    "minVersion":"1.100.2"
                },
                "sap.ui.layout":{
                    "minVersion":"latest"
                }
            }
        },
        "contentDensities":{
            "compact":true,
            "cozy":true
        },
        "models":{
            "":{
                "type":"sap.ui.model.odata.v2.ODataModel",
                "dataSource":"ZTEST_DELIVERY_ODATA_SRV",
                "settings":{}
            },
            "local":{
                "type":"sap.ui.model.json.JSONModel",
                "uri":"Model/fruits.json"
            },
            "i18n":{
                "type":"sap.ui.model.resource.ResourceModel",
                "settings":{
                    "bundleUrl":"i18n/i18n.properties"
                }
            }
        },
        "rootView":{
            "viewName":"tv.sd.abap.View.Root",
            "type":"XML",
            "id":"idRootView"
        },
        "routing":{
            "config":{
                "viewPath":"tv.sd.abap.View",
                "viewType":"XML",
                "controlId":"idSplitApp"
            },
            "routes":[
                {
                    "name":"route1",
                    "pattern":"",
                    "target":["donald","modi"]
                },
                {
                    "name":"route2",
                    "pattern":"ZTEST_DELIVERY_ODATA_SRV/{deliveryId}",
                    "target":["donald","imran"]
                },
                {
                    "name":"route3",
                    "pattern":"supplier/{supplierId}",
                    "target":["donald","supplier"]
                },
                {
                    "name":"add",
                    "pattern":"manageOrders",
                    "target":["donald","kamala"]
                }
            ],
            "targets":{
                "donald":{
                    "id":"idView1",
                    "viewName":"View1",
                    "controlAggregation":"masterPages"
                },
                "modi":{
                    "id":"idEmpty",
                    "viewName":"Empty",
                    "controlAggregation":"detailPages"
                },
                "imran":{
                    "id":"idView2",
                    "viewName":"View2",
                    "controlAggregation":"detailPages",
                    "clearControlAggregation":true
                },
                "supplier":{
                    "id":"idSupplier",
                    "viewName":"View3",
                    "controlAggregation":"detailPages",
                    "clearControlAggregation":true
                },
                "kamala":
                {
                    "id":"idKamala",
                    "viewName":"Add",
                    "controlAggregation":"detailPages",
                    "clearControlAggregation":true
                }
            }
        }
    }
}