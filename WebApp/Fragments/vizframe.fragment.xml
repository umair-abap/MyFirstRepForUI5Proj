<mvc:FragmentDefinition xmlns:mvc="sap.ui.core" xmlns="sap.m"
 xmlns:viz="sap.viz.ui5.controls" xmlns:data="sap.viz.ui5.data"
>
    <viz:VizFrame id="idVizFrame" height='100%' width="100%" vizType='donut'>
        <viz:dataset>
            <viz.data:FlattenedDataset data="{/supplier}">
                <viz.data:dimensions>
                    <viz.data:DimensionDefinition name="Store Name"
                        value="{name}" />
                </viz.data:dimensions>
                <viz.data:measures>
                    <viz.data:MeasureDefinition name="Revenue"
                        value="{specialty/supply}" />
                </viz.data:measures>
            </viz.data:FlattenedDataset>
        </viz:dataset>
    </viz:VizFrame>
</mvc:FragmentDefinition>